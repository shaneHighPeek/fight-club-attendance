rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == "admin";
    }

    function isBootstrapAdmin() {
      // Dev bootstrap alignment with frontend env fallback.
      return isSignedIn() && (
        request.auth.token.email == "shane@drpresident.com" ||
        request.auth.token.email == "shane@highpeekpro.com"
      );
    }

    function isManager() {
      return isSignedIn() && request.auth.token.role == "manager";
    }

    function isCoachOrAdmin() {
      return isSignedIn() && (
        request.auth.token.role == "coach" ||
        request.auth.token.role == "manager" ||
        request.auth.token.role == "admin" ||
        isBootstrapAdmin()
      );
    }

    function isKioskCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "lastCheckIn",
        "rankAttendance",
        "streakBestWeeks",
        "streakCurrentWeeks",
        "streakLastWeekId",
        "totalCheckIns",
        "waiverAcceptedAt",
        "waiverDisclaimerVersion",
        "updatedAt",
        "status"
      ]) &&
      request.resource.data.lastCheckIn is timestamp &&
      request.resource.data.updatedAt is timestamp &&
      (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"]) ||
        request.resource.data.status is string
      ) &&
      request.resource.data.totalCheckIns is int &&
      (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["streakCurrentWeeks"]) ||
        request.resource.data.streakCurrentWeeks is int
      ) &&
      (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["streakBestWeeks"]) ||
        request.resource.data.streakBestWeeks is int
      ) &&
      (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["streakLastWeekId"]) ||
        request.resource.data.streakLastWeekId is string
      ) &&
      (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["rankAttendance"]) ||
        request.resource.data.rankAttendance is map
      ) &&
      (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["waiverAcceptedAt"]) ||
        request.resource.data.waiverAcceptedAt is timestamp
      ) &&
      (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["waiverDisclaimerVersion"]) ||
        request.resource.data.waiverDisclaimerVersion is string
      );
    }

    function isMemberWaiverRefreshUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "waiverAcceptedAt",
        "waiverDisclaimerVersion",
        "updatedAt"
      ]) &&
      request.resource.data.updatedAt is timestamp &&
      request.resource.data.waiverAcceptedAt is timestamp &&
      request.resource.data.waiverDisclaimerVersion is string;
    }

    function isStaffRankUpdate() {
      return isSignedIn() &&
      request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "rank",
        "rankProfile",
        "ageBand",
        "updatedAt"
      ]) &&
      request.resource.data.rank is map &&
      request.resource.data.rank.belt is string &&
      request.resource.data.rank.stripes is int &&
      request.resource.data.rank.stripes >= 0 &&
      request.resource.data.rank.stripes <= 10 &&
      request.resource.data.updatedAt is timestamp &&
      (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["ageBand"]) ||
        request.resource.data.ageBand is string
      ) &&
      (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["rankProfile"]) ||
        (
          request.resource.data.rankProfile is map &&
          request.resource.data.rankProfile.rankStepId is string &&
          request.resource.data.rankProfile.rankStepOrder is int &&
          request.resource.data.rankProfile.rankSystem is string &&
          request.resource.data.rankProfile.beltName is string &&
          request.resource.data.rankProfile.baseColour is string
        )
      );
    }

    match /members/{memberId} {
      // v1 kiosk lookup requires member search without staff sign-in.
      // Tighten later with App Check + callable boundary if needed.
      allow read: if true;
      allow create, delete: if isAdmin() || isBootstrapAdmin();
      allow update: if isAdmin() || isBootstrapAdmin() || isKioskCounterUpdate() || isStaffRankUpdate() || isMemberWaiverRefreshUpdate();
    }

    match /attendanceLogs/{logId} {
      allow create: if true;
      allow read: if isSignedIn();
      allow update, delete: if false;
    }

    match /memberRankHistory/{historyId} {
      allow read: if isCoachOrAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /waivers/{waiverId} {
      allow create: if true;
      allow read: if isCoachOrAdmin();
      allow update, delete: if false;
    }

    match /webhookEvents/{eventId} {
      allow read: if isCoachOrAdmin();
      allow write: if false;
    }

    match /classOverrides/{overrideId} {
      // The kiosk is intentionally unauthenticated and needs today's effective schedule.
      allow read: if true;
      allow create, update, delete: if isCoachOrAdmin();
    }

    match /settings/classSchedule {
      allow read: if true;
      allow write: if isAdmin() || isBootstrapAdmin() || isManager();
    }

    match /settings/{settingId} {
      allow read: if isCoachOrAdmin();
      allow write: if isAdmin() || isBootstrapAdmin();
    }

    match /staffUsers/{userId} {
      allow read: if isCoachOrAdmin();
      allow write: if isAdmin() || isBootstrapAdmin();
    }
  }
}
