# Firebase project and emulator toggles
FIREBASE_PROJECT_ID=fight-club-attendance-dev
USE_FIREBASE_EMULATORS=true

# Frontend runtime (prefixed VITE_ for web)
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=replace-me.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fight-club-attendance-dev
VITE_FIREBASE_STORAGE_BUCKET=replace-me.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me
VITE_USE_FIREBASE_EMULATORS=false

# Cloud Functions / integration
HIGHPEAKPRO_WEBHOOK_URL=https://example.com/inbound/webhook
HIGHPEAKPRO_BEARER_TOKEN=replace-me
WEBHOOK_SIGNING_SECRET=replace-me
